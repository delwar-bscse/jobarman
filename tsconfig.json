{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next\\dev/types/**/*.ts",
    ".next\\dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "src/app/(guest)/layout.jsx",
    "src/app/(jobSeeker)/layout.jsx",
    "src/app/(auth)/layout.jsx",
    "src/app/(recruiter)/layout.jsx",
    "src/app/(allUser)/chat/page.jsx",
    "src/components/recruiter/recruitment-status/page.jsx",
    "src/components/recruiter/recruitment-status/recent-applicants.jsx",
    "src/components/recruiter/recruitment-status/metrics-card.jsx",
    "src/app/(recruiter)/job-post/page.jsx",
    "src/app/(recruiter)/seeker-resume/page.jsx",
    "src/components/modal/CustomModal.jsx",
    "utils/revalidateTags.js",
    "src/components/guest/RecentJobPost.jsx",
    "src/components/recruiter/recruitment-status/interviews/CancelInterview.jsx",
    "src/app/(recruiter)/(status)/interview-job-details/[id]/page.jsx",
    "src/components/recruiter/recruitment-status/Calendar.jsx",
    "src/components/recruiter/recruitment-status/InterviewSheduleModal.jsx",
    "src/app/(recruiter)/(status)/interviews/page.jsx",
    "src/components/recruiter/recruitment-status/interviews/Interviews.jsx",
    "src/app/(recruiter)/(status)/short-list/page.jsx",
    "src/components/recruiter/recruitment-status/ShortListResume.jsx",
    "src/components/recruiter/recruitment-status/ShortList.jsx",
    "src/components/recruiter/recruitment-status/UserResume.jsx",
    "src/app/(jobSeeker)/my-resume/page.jsx",
    "src/app/(recruiter)/my-job-details/[post]/page.jsx",
    "src/app/(recruiter)/job-post/skills-input.jsx"
  ],
  "exclude": ["node_modules"]
}
